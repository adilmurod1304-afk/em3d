<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1017"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <ImageView
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginTop="80dp"
        android:background="@drawable/bg_icon_circle"
        android:padding="18dp"
        android:src="@drawable/ic_shield"
        app:tint="#6366F1"
        android:contentDescription="@null" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/locked_title"
        android:textColor="#ECEEF4"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/overlayStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/locked_sub"
        android:textColor="#98A1B3"
        android:textSize="14sp" />

    <FrameLayout
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_chip">

        <androidx.camera.view.PreviewView
            android:id="@+id/overlayPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:implementationMode="compatible" />
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/use_pin"
        android:textColor="#98A1B3"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/overlayPin"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="#1E2433"
        android:gravity="center"
        android:hint="PIN"
        android:inputType="numberPassword"
        android:padding="14dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#667085"
        android:autofillHints="" />

    <Button
        android:id="@+id/overlayUnlock"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:backgroundTint="#6366F1"
        android:text="@string/btn_unlock_pin"
        android:textColor="#FFFFFF" />

    <TextView
        android:id="@+id/overlayMsg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="#F87171"
        android:textSize="13sp" />
</LinearLayout>
